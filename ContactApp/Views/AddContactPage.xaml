<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ContactApp.Views.Controls"
             x:Class="ContactApp.Views.AddContactPage"
             Title="Add Contact">
    <ScrollView>
        <controls:ContactControl 
           x:Name="contactControl"
           OnSaveClicked="BtnSave_Clicked"
           OnCancelClicked="BtnCancel_Clicked"
           OnError="ContactControl_OnError" />
    </ScrollView>
</ContentPage>