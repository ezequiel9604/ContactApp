<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ContactApp.Views.ContactPage"
             Title="Contacts">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- 🔍 Search Bar -->
        <SearchBar x:Name="searchBar"
                   Grid.Row="0"
                   Placeholder="Search contacts..."
                   PlaceholderColor="#C7C7CC"
                   TextColor="#1C1C1E"
                   CancelButtonColor="#1A73E8"
                   BackgroundColor="Transparent"
                   Margin="0,8,14,0"
                   TextChanged="SearchBar_TextChanged"/>

        <CollectionView x:Name="listContacts"
                        Grid.Row="1"
                        BackgroundColor="Transparent"
                        SelectionMode="None"
                        Margin="16,8"
                        VerticalScrollBarVisibility="Never">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
            </CollectionView.ItemsLayout>

            <CollectionView.EmptyView>
                <Grid Padding="32">
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                        <Label Text="👥" FontSize="48" HorizontalOptions="Center" />
                        <Label Text="No contacts yet"
                               FontSize="16"
                               TextColor="#8E8E93"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Grid>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView SwipeStarted="OnSwipeStarted"
                               SwipeEnded="OnSwipeEnded">
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Reveal">
                                <SwipeItem Text="Edit"
                                           BackgroundColor="#1A73E8"
                                           Invoked="OnEditSwipeInvoked"
                                           CommandParameter="{Binding .}" />
                                <SwipeItem Text="Delete"
                                           BackgroundColor="Coral"
                                           Invoked="OnDeleteSwipeInvoked"
                                           CommandParameter="{Binding .}" />
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <Border Padding="8"
                                BackgroundColor="White"
                                StrokeShape="RoundRectangle 8"
                                StrokeThickness="0"
                                Margin="4,2">

                            <!-- Tap replaces selection -->
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnContactTapped" />
                            </Border.GestureRecognizers>

                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.08" />
                            </Border.Shadow>

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                <Border Grid.Column="0"
                                        WidthRequest="30"
                                        HeightRequest="30"
                                        BackgroundColor="#E8F0FE"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 24">
                                    <Label Text="{Binding Initials}"
                                           TextColor="#1A73E8"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>

                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding Name}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#1C1C1E" />
                                    <Label Text="{Binding PhoneNumber}"
                                           FontSize="12"
                                           TextColor="#8E8E93" />
                                </VerticalStackLayout>

                                <Label Grid.Column="2"
                                       Text="›"
                                       FontSize="24"
                                       TextColor="#C7C7CC"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button x:Name="btnAddContact"
                Grid.Row="2"
                Text="Add Contact"
                BackgroundColor="#1A73E8"
                TextColor="White"
                FontSize="16"
                CornerRadius="8"
                HeightRequest="48"
                Margin="16,8"
                Clicked="BtnAddContact_Clicked" />
    </Grid>
</ContentPage>