<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ContactApp.Views.ContactPage"
             Title="Contacts">
    <VerticalStackLayout>

        <CollectionView 
            x:Name="listContacts"
            BackgroundColor="Transparent"
            SelectionMode="Single"
            Margin="16,8"
            VerticalScrollBarVisibility="Never"
            SelectionChanged="ListContacts_SelectionChanged">

            <!-- Spacing between items -->
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
            </CollectionView.ItemsLayout>

            <!-- Empty view -->
            <CollectionView.EmptyView>
                <Grid Padding="32">
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                        <Label Text="👥" FontSize="48" HorizontalOptions="Center" />
                        <Label Text="No contacts yet" 
                       FontSize="16" 
                       TextColor="#8E8E93" 
                       HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Grid>
            </CollectionView.EmptyView>

            <!-- Item template -->
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="8"
                    BackgroundColor="White"
                    StrokeShape="RoundRectangle 8"
                    StrokeThickness="0"
                    Margin="4,2">
                        <Border.Shadow>
                            <Shadow Brush="Black" 
                            Offset="0,2" 
                            Radius="8" 
                            Opacity="0.08" />
                        </Border.Shadow>

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <!-- Avatar -->
                            <Border Grid.Column="0"
                            WidthRequest="30"
                            HeightRequest="30"
                            BackgroundColor="#E8F0FE"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 24">
                                <Label Text="{Binding Initials}"
                               TextColor="#1A73E8"
                               FontSize="14"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                            </Border>

                            <!-- Info -->
                            <VerticalStackLayout Grid.Column="1" 
                                         VerticalOptions="Center" 
                                         Spacing="2">
                                <Label Text="{Binding Name}"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#1C1C1E" />
                                <Label Text="{Binding PhoneNumber}"
                               FontSize="12"
                               TextColor="#8E8E93" />
                            </VerticalStackLayout>

                            <!-- Chevron -->
                            <Label Grid.Column="2"
                           Text="›"
                           FontSize="24"
                           TextColor="#C7C7CC"
                           VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>