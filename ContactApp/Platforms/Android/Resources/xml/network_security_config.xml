<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
	<!-- Default for the whole app: HTTPS only, trust system CAs -->
	<base-config cleartextTrafficPermitted="false">
		<trust-anchors>
			<certificates src="system" />
		</trust-anchors>
	</base-config>

	<!-- Allow plain HTTP only to local development hosts -->
	<domain-config cleartextTrafficPermitted="true">
		<!-- Android emulator alias for the host machine's localhost -->
		<domain includeSubdomains="false">10.0.2.2</domain>
		<domain includeSubdomains="false">localhost</domain>
		<domain includeSubdomains="false">127.0.0.1</domain>
		<!-- Add your machine's LAN IP here if testing on a physical device, e.g.: -->
		<!-- <domain includeSubdomains="false">192.168.1.50</domain> -->
	</domain-config>

	<!-- In debug builds, also trust user-installed CAs (e.g. for Charles/Fiddler/mitmproxy) -->
	<debug-overrides>
		<trust-anchors>
			<certificates src="system" />
			<certificates src="user" />
		</trust-anchors>
	</debug-overrides>
</network-security-config>